# Get a free key at https://build.nvidia.com (any Nemotron model page -> "Get API Key")
NVIDIA_API_KEY=

# Any Nemotron chat model on build.nvidia.com works. Super is the best quality/speed trade-off.
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# OpenAI-compatible endpoint. Point this at a local server (e.g. Ollama: http://localhost:11434/v1)
# to run Nemotron locally without a key.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Seconds before an LLM call gives up and the offline brain answers instead.
LLM_TIMEOUT=45

PORT=3000
